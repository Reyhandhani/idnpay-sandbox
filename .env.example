# Salin menjadi .env lalu sesuaikan. Penjelasan lengkap ada di docs/CONFIGURATION.md.

# Server
HOST=0.0.0.0
PORT=9000
LOG_LEVEL=info
DASHBOARD_ENABLED=true

# Autentikasi. Ganti kedua nilai ini sebelum simulator dapat diakses orang lain.
CLIENT_KEY=idnpay-dev-client-key
SECRET_KEY=idnpay-dev-secret-key

# Transaksi
CHARGE_EXPIRY_MINUTES=60
MERCHANT_NAME=IDNPAY MOCK
MERCHANT_CITY=JAKARTA
TRANSACTION_STORE_LIMIT=10000

# Webhook
WEBHOOK_RETRY_LIMIT=5
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_TICK_MS=500

# Antrean. Kosongkan untuk memakai memori.
REDIS_URL=

# Simulasi jaringan
SIMULATED_LATENCY_MS=0
SIMULATED_FAILURE_RATE=0
