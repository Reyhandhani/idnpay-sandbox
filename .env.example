# Copy to .env and adjust. Every variable is documented in docs/CONFIGURATION.md.

# Server
HOST=0.0.0.0
PORT=9000
LOG_LEVEL=info
DASHBOARD_ENABLED=true

# Authentication. Change both values before anyone else can reach the simulator.
CLIENT_KEY=idnpay-dev-client-key
SECRET_KEY=idnpay-dev-secret-key

# Transactions
CHARGE_EXPIRY_MINUTES=60
MERCHANT_NAME=IDNPAY MOCK
MERCHANT_CITY=JAKARTA
TRANSACTION_STORE_LIMIT=10000

# Webhooks
WEBHOOK_RETRY_LIMIT=5
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_TICK_MS=500

# Queue. Leave empty to use the in-memory queue.
REDIS_URL=

# Network simulation
SIMULATED_LATENCY_MS=0
SIMULATED_FAILURE_RATE=0
